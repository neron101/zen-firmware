#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        back {
            bindings = <&kp BACKSPACE>;
            key-positions = <11 10>;
        };

        ent {
            bindings = <&kp ENTER>;
            key-positions = <23 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&lt 3 TAB         &kp Q         &kp W           &kp E     &kp R             &kp T        &kp Y        &kp U         &kp I       &kp O           &kp P           &kp MINUS
&kp CLCK          &kp A         &kp S           &kp D     &kp F             &kp G        &kp H        &kp J         &kp K       &kp L           &kp SLASH       &kp PLUS
&kp LSHFT         &kp Z         &kp X           &kp C     &kp V             &kp B        &lt 4 SPACE  &lt 3 DELETE  &kp N       &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &kp QUESTION
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_BRACE  &mkp MB2  &kp LEFT_COMMAND  &lt 2 SPACE  &mkp MB1     &lt 1 ENTER   &kp DELETE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans      &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)      &kp RS(NUMBER_6)  &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(N0)  &trans
&trans      &kp LEFT          &kp UP            &kp RIGHT_ARROW   &trans            &kp LANG1       &trans            &trans      &trans      &trans      &trans      &trans
&trans      &kp LEFT_ARROW    &kp DOWN_ARROW    &kp RIGHT_ARROW   &trans            &kp LANGUAGE_2  &trans            &trans      &trans      &trans      &trans      &trans  &trans  &kp SLASH
&kp ESCAPE  &trans            &trans            &kp RIGHT_BRACE   &trans            &trans          &trans            &trans      &trans      &trans      &trans      &trans
            >;
        };

        layer_2 {
            bindings = <
&trans      &kp N1          &kp N2    &kp N3           &kp N4  &kp N5          &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DELETE
&trans      &kp LEFT        &kp UP    &kp RIGHT        &trans  &kp LANGUAGE_1  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW  &trans  &kp LANGUAGE_2  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp SLASH
&kp ESCAPE  &trans          &trans    &kp RIGHT_BRACE  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans        &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans        &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans          &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &bt BT_CLR_ALL  &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
